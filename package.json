{
  "name": "mysite",
  "version": "1.0.0",
  "description": "Zero-dependency Markdown static site generator built with pure Node.js stdlib",
  "type": "module",
  "main": "bin/mysite.js",
  "bin": {
    "mysite": "./bin/mysite.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "node bin/mysite.js build --src examples/demo-site --out dist",
    "serve": "node bin/mysite.js serve --src examples/demo-site --port 3000",
    "lint": "node bin/mysite.js lint --src examples/demo-site",
    "test": "node --test tests/*.test.js",
    "verify-zero-dep": "node bin/mysite.js verify-zero-dep",
    "verify-reproducible": "node bin/mysite.js verify-reproducible"
  },
  "dependencies": {},
  "devDependencies": {}
}
